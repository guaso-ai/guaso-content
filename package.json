{
  "name": "@guaso-ai/content",
  "version": "0.4.0",
  "description": "Guaso Content SDK \u2014 server-only read client for headless content",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    },
    "./schemas/blocks": {
      "types": "./dist/schemas/blocks.d.ts",
      "import": "./dist/schemas/blocks.js",
      "default": "./dist/schemas/blocks.js"
    },
    "./schemas/templates/*": {
      "types": "./dist/schemas/templates/*.d.ts",
      "import": "./dist/schemas/templates/*.js",
      "default": "./dist/schemas/templates/*.js"
    }
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import ./tests/register-server-only-mock.mjs --import tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guaso-ai/guaso-content.git"
  },
  "homepage": "https://github.com/guaso-ai/guaso-content#readme",
  "bugs": {
    "url": "https://github.com/guaso-ai/guaso-content/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "guaso",
    "content",
    "headless",
    "server-only"
  ]
}
